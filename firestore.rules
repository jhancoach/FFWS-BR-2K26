rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false; 
    }
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return incoming().pin == '221120';
    }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isValidStudyMap(data) {
      // The only strict field is mapId
      return data.keys().hasAny(['mapId']) 
          && data.mapId is string
          && data.mapId.size() <= 10; // 'BER', 'PUR', etc.
    }

    match /studies/{mapId} {
      // ANYONE can read the map studies (public stats)
      allow read: if true;
      
      // ONLY Admin can create/update
      allow create: if isAdmin() 
                    && isValidId(mapId) 
                    && isValidStudyMap(incoming());
                    
      // On update, we just ensure mapId isn't changed
      allow update: if isAdmin() 
                    && isValidStudyMap(incoming())
                    && incoming().mapId == existing().mapId;
                    
      allow delete: if isAdmin();
    }
  }
}
